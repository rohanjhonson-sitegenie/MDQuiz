# Theme Configuration
# Available presets: default, emerald, crimson, ocean, sunset
VITE_THEME_PRESET=default
# Default theme mode: light, dark, system
VITE_DEFAULT_MODE=system
# Enable custom color overrides
VITE_ENABLE_CUSTOM_THEME=false
# Custom color overrides (only used when VITE_ENABLE_CUSTOM_THEME=true)
# Colors should be in OKLCH format: "lightness chroma hue"
# Example: VITE_PRIMARY_COLOR=0.6 0.16 163
# VITE_PRIMARY_COLOR=
# VITE_SECONDARY_COLOR=
# VITE_ACCENT_COLOR=

# Navbar Theme Configuration
# Set to true to reverse navbar theme (dark navbar when app is light, light navbar when app is dark)
VITE_NAVBAR_REVERSE_THEME=false
# Custom Navbar Colors (only used if VITE_ENABLE_CUSTOM_THEME=true)
# VITE_NAVBAR_BACKGROUND_COLOR=
# VITE_NAVBAR_FOREGROUND_COLOR=
# VITE_NAVBAR_PRIMARY_COLOR=

# Application URL (used for sitemaps and SEO)
VITE_APP_URL=https://your-domain.com

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the new publishable key (starts with sb_publishable_...)
# Legacy anon key is still supported for backward compatibility
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# CautionTape ID Service Configuration
# Development: https://devid.ctedu.ca
# Production: https://id.ctedu.ai
VITE_ID_SERVICE_URL=https://devid.ctedu.ca

# Bunny CDN (Public URL only - no API keys in frontend!)
# Optional: If not provided, images will show placeholders in development
# and the application will still work without errors
VITE_BUNNY_CDN_URL=https://react-vite-shadcn-boilerplate.b-cdn.net

# API Server URL (for AI and Storage proxy)
VITE_API_URL=http://localhost:3001