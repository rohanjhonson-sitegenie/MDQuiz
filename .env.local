# React App Development Environment Configuration
# This file contains PUBLIC keys only - frontend accessible
# DO NOT add any secret/private keys here

# Theme Configuration
# Controls the visual theme preset for the application UI
VITE_THEME_PRESET=emerald
# Sets default color mode: 'light', 'dark', or 'system' (auto-detect)
VITE_DEFAULT_MODE=system
# Enables custom theme color picker in settings (true/false)
VITE_ENABLE_CUSTOM_THEME=false

# Supabase Configuration (PUBLIC keys only)
