# React App Development Environment Configuration
# This file contains PUBLIC keys only - frontend accessible
# DO NOT add any secret/private keys here

# Theme Configuration
# Controls the visual theme preset for the application UI
VITE_THEME_PRESET=ct
VITE_NAVBAR_REVERSE_THEME=false

# Custom Navbar Colors (requires VITE_ENABLE_CUSTOM_THEME=true)
VITE_NAVBAR_BACKGROUND_COLOR=#191919
VITE_NAVBAR_FOREGROUND_COLOR=#ffffff

# Sets default color mode: 'light', 'dark', or 'system' (auto-detect)
VITE_DEFAULT_MODE=system
# Enables custom theme color picker in settings (true/false)
VITE_ENABLE_CUSTOM_THEME=false

# Supabase Configuration (PUBLIC keys only)
# Your Supabase project URL - safe for frontend
# Used to connect to Supabase from the browser
VITE_SUPABASE_URL=https://nfiavjpjeygamrkcmbci.supabase.co
# Use the new publishable key (starts with sb_publishable_...)
# Legacy anon key is still supported for backward compatibility
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zjK-QcNXZVcbQEHMRABZHQ_97QiYZCd

# API Server URL (for AI and Storage proxy)
VITE_API_URL=https://apiproxy.ct839.com

# Bunny CDN URL for image transformation
VITE_BUNNY_CDN_URL=https://react-vite-shadcn-boilerplate.b-cdn.net

# YouTube API Configuration
# Public API key for accessing YouTube Data API v3
VITE_YOUTUBE_API_KEY=AIzaSyBoKAMSrHo0s1fM5chr9HFzTlrWlN-CqY4

# CautionTape ID Service Configuration
# URL for the CautionTape ID Service authentication provider
VITE_ID_SERVICE_URL=https://devid.ctedu.ca

# Node Environment
# Tells build tools we're in development mode
NODE_ENV=development