VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InloeGRwb2JtYXBwcWx6eGduaGV1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTMyOTI1NjUsImV4cCI6MjA2ODg2ODU2NX0.M7AzpAu-_-nraaR67ihnu8NN1n-dyNtOAWSpXBSWQqQ

